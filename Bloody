def generate_dom_protection_script(site_id: str, tracking_domain: str) -> str:
    """
    Generate JavaScript to embed in your web pages for:
    1. Content integrity checking
    2. Theft detection beacon
    3. Attribution persistence
    """
    script = f'''
// DOM Protection Script — {site_id}
(function() {{
    const SITE_ID = '{site_id}';
    const TRACKING_DOMAIN = '{tracking_domain}';
    const TRACKING_ENDPOINT = `{{TRACKING_DOMAIN}}/beacon/{{SITE_ID}}`;
    
    // 1. Generate unique session fingerprint
    function generateSessionFingerprint() {{
        const components = [
            navigator.userAgent,
            screen.width + 'x' + screen.height,
            new Date().getTimezoneOffset(),
            Math.random().toString(36).substring(7)
        ];
        return btoa(components.join('|'));
    }}
    
    // 2. Load tracking pixel (invisible)
    function fireTrackingBeacon(eventType, extraData = {{}}) {{
        const payload = {{
            siteId: SITE_ID,
            eventType: eventType,
            timestamp: Date.now(),
            url: window.location.href,
            referrer: document.referrer,
            sessionFingerprint: generateSessionFingerprint(),
            ...extraData
        }};
        
        try {{
            const blob = new Blob([JSON.stringify(payload)], {{ type: 'application/json' }});
            const reader = new FileReader();
            reader.onloadend = function() {{
                const pixel = document.createElement('img');
                pixel.src = `{{TRACKING_ENDPOINT}}?t={{encodeURIComponent(reader.result)}}`;
                pixel.style.display = 'none';
                document.body.appendChild(pixel);
                setTimeout(() => pixel.remove(), 1000);
            }};
            reader.readAsDataURL(blob);
        }} catch (e) {{
            console.warn('[DOM Protection]', e);
        }}
    }}
    
    // 3. Integrity check: detect DOM manipulation
    const originalBodyHTML = document.body.innerHTML;
    setInterval(() => {{
        if (document.body.innerHTML !== originalBodyHTML) {{
            fireTrackingBeacon('DOM_MODIFIED', {{
                originalHash: btoa(originalBodyHTML).slice(0, 32),
                currentHash: btoa(document.body.innerHTML).slice(0, 32)
            }});
        }}
    }}, 5000);
    
    // 4. Detect copy attempts
    document.addEventListener('copy', () => {{
        fireTrackingBeacon('COPY_ATTEMPT');
    }});
    
    document.addEventListener('contextmenu', (e) => {{
        fireTrackingBeacon('RIGHT_CLICK', {{ x: e.clientX, y: e.clientY }});
    }});
    
    // 5. Fire load tracking
    fireTrackingBeacon('PAGE_LOAD');
    
    // 6. Add persistent attribution comment
    const attributionComment = document.createComment(
        `Original content from: ${{TRACKING_DOMAIN}} | Site ID: ${{SITE_ID}}`
    );
    document.head.appendChild(attributionComment);
    
    console.log('[DOM Protection] Active for', SITE_ID);
}})();
    '''
    return script


