class HashLedger:
    """
    Immutable hash chain ledger for proving content existed at a point in time.
    Each entry includes a timestamp, content hash, and previous hash (Merkle-style).
    """
    
    def __init__(self, ledger_path: str = ".evidence_ledger.json"):
        self.ledger_path = Path(ledger_path)
        self.entries: List[Dict[str, Any]] = []
        
    def _load(self) -> None:
        if self.ledger_path.exists():
            with open(self.ledger_path, 'r') as f:
                data = json.load(f)
                self.entries = data.get('entries', [])
        else:
            self.entries = []
            
    def _save(self) -> None:
        data = {
            'version': 1,
            'created_at': datetime.datetime.utcnow().isoformat(),
            'entries': self.entries
        }
        with open(self.ledger_path, 'w') as f:
            json.dump(data, f, indent=2)
            
    def add_entry(self, content_hash: str, content_type: str, 
                  description: str, metadata: Optional[Dict] = None) -> str:
        """
        Add a new entry to the ledger. Returns the entry ID.
        Each entry is chained via the previous hash for immutability.
        """
        self._load()
        
        previous_hash = self.entries[-1]['hash'] if self.entries else 'GENESIS'
        
        # Compute this entry's hash (includes previous for chaining)
        entry_data = {
            'id': str(uuid.uuid4()),
            'timestamp': datetime.datetime.utcnow().isoformat(),
            'previous_hash': previous_hash,
            'content_hash': content_hash,
            'content_type': content_type,
            'description': description,
            'metadata': metadata or {}
        }
        
        # Chain hash computation
        chain_string = f"{previous_hash}:{content_hash}:{entry_data['timestamp']}"
        entry_hash = hashlib.sha256(chain_string.encode()).hexdigest()
        entry_data['hash'] = entry_hash
        
        self.entries.append(entry_data)
        self._save()
        
        return entry_data['id']
    
    def verify_integrity(self) -> bool:
        """Verify the ledger hasn't been tampered with."""
        if not self.entries:
            return True
            
        for i, entry in enumerate(self.entries):
            if i == 0:
                expected_prev = 'GENESIS'
            else:
                expected_prev = self.entries[i-1]['hash']
                
            if entry['previous_hash'] != expected_prev:
                print(f"[FAIL] Entry {i}: Previous hash mismatch")
                return False
                
        return True
    
    def export_to_blockchain_timestamp(self) -> Dict[str, Any]:
        """
        Export latest entry for public timestamping services.
        Consider submitting hash to:
        - OpenTimestamps (https://opentimestamps.org)
        - Blockstream (Bitcoin blockchain)
        """
        if not self.entries:
            raise ValueError("No entries to export")
            
        return {
            'hash': self.entries[-1]['hash'],
            'timestamp': self.entries[-1]['timestamp'],
            'content_type': self.entries[-1]['content_type'],
            'ledger_size': len(self.entries)
        }


def compute_file_hash(filepath: str, algorithm: str = 'sha256') -> str:
    """Compute hash of a file in chunks (memory efficient)."""
    hasher = hashlib.new(algorithm)
    with open(filepath, 'rb') as f:
        while chunk := f.read(8192):
            hasher.update(chunk)
    return hasher.hexdigest()


def compute_string_hash(content: str, algorithm: str = 'sha256') -> str:
    """Compute hash of string content."""
    return hashlib.new(algorithm, content.encode()).hexdigest()


