def embed_text_watermark(text: str, watermark: str, 
                         method: str = 'invisible_unicode') -> str:
    """
    Embed a watermark into text using various methods.
    
    Methods:
    - invisible_unicode: Zero-width characters between words
    - whitespace_shift: Alter whitespace patterns (subtle)
    - sentence_capitalization: Encode bits via capitalization (visible)
    """
    if method == 'invisible_unicode':
        # Use zero-width space U+200B and zero-width non-joiner U+200C
        wm_bytes = watermark.encode('utf-8')
        encoded = ''
        for byte in wm_bytes:
            if byte % 2 == 0:
                encoded += '\u200B'  # Zero-width space
            else:
                encoded += '\u200C'  # Zero-width non-joiner
        # Insert encoded watermark throughout the text
        words = text.split()
        result = []
        for i, word in enumerate(words):
            result.append(word)
            if i < len(encoded):
                result.append(encoded[i])
        return ' '.join(result)
        
    elif method == 'whitespace_shift':
        # Alternate single vs double spaces based on watermark bits
        wm_binary = ''.join(format(b, '08b') for b in watermark.encode())
        words = text.split()
        result = [words[0]]
        bit_idx = 0
        for i in range(1, len(words)):
            spacer = '  ' if bit_idx < len(wm_binary) and wm_binary[bit_idx] == '1' else ' '
            if bit_idx < len(wm_binary):
                bit_idx += 1
            result.append(spacer + words[i])
        return ''.join(result)
        
    else:
        # Fallback: append to end
        return text + f"\n<!-- Watermarked: {watermark} -->"


def extract_text_watermark(text: str, method: str = 'invisible_unicode') -> Optional[str]:
    """Extract watermark from watermarked text."""
    if method == 'invisible_unicode':
        # Extract zero-width characters
        zws = '\u200B'  # Even bit
        zwj = '\u200C'  # Odd bit
        bits = []
        for char in text:
            if char == zws:
                bits.append('0')
            elif char == zwj:
                bits.append('1')
        
        if not bits:
            return None
            
        # Convert bits to bytes
        binary_str = ''.join(bits[:len(bits)//8*8])  # Round down to byte boundary
        result = []
        for i in range(0, len(binary_str), 8):
            byte_val = int(binary_str[i:i+8], 2)
            result.append(byte_val)
        return bytes(result).decode('utf-8', errors='ignore')
        
    return None


