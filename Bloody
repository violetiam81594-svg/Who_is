def generate_content_signature(*components: str) -> str:
    """Generate a verification signature from multiple components."""
    combined = ':'.join(components)
    return hashlib.sha256(combined.encode()).hexdigest()[:32]


def create_audio_watermark(audio_path: str, watermark: str, 
                           output_path: str, strength: float = 0.5) -> bool:
    """
    Add audible/inaudible frequency watermark to audio.
    Requires scipy and numpy.
    """
    try:
        import numpy as np
        from scipy.io import wavfile
    except ImportError:
        print("[ERROR] scipy and numpy required. Run: pip install scipy numpy")
        return False
    
    sample_rate, data = wavfile.read(audio_path)
    
    # Generate frequency-based watermark (simplified)
    # In production, use spread spectrum techniques
    wm_duration = 0.5  # seconds
    wm_samples = int(sample_rate * wm_duration)
    freq = 19000  # Near upper limit of human hearing
    
    time_axis = np.arange(wm_samples) / sample_rate
    watermark_signal = np.sin(2 * np.pi * freq * time_axis) * strength
    watermark_signal = np.concatenate([watermark_signal, np.zeros(len(data) - wm_samples)])
    
    watermarked_data = data + (watermark_signal * np.max(np.abs(data)) * 0.01)
    watermarked_data = np.clip(watermarked_data, -np.iinfo(data.dtype).max, np.iinfo(data.dtype).max)
    
    wavfile.write(output_path, sample_rate, watermarked_data.astype(data.dtype))
    return True


