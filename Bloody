class BeaconLogHandler(BaseHTTPRequestHandler):
    """HTTP handler that logs incoming tracking beacons."""
    
    def do_GET(self):
        parsed = urlparse(self.path)
        
        if parsed.path.startswith('/beacon/'):
            # Extract tracking data from query string
            params = dict(urlparse.parse_qsl(parsed.query))
            beacon_data = {
                'timestamp': datetime.datetime.utcnow().isoformat(),
                'client_ip': self.client_address[0],
                'user_agent': self.headers.get('User-Agent', 'unknown'),
                **params
            }
            
            # Log to file
            log_dir = Path('./beacon_logs')
            log_dir.mkdir(exist_ok=True)
            log_file = log_dir / f"beacons_{datetime.date.today().isoformat()}.jsonl"
            
            with open(log_file, 'a') as f:
                f.write(json.dumps(beacon_data) + '\n')
            
            print(f"[LOGGED] Beacon from {beacon_data['client_ip']}: {beacon_data.get('eventType', 'UNKNOWN')}")
            
            # Send back acknowledgement with verification
            response = {
                'status': 'logged',
                'logged_at': beacon_data['timestamp'],
                'your_ip': self.client_address[0]
            }
            
        else:
            response = {'error': 'Not found'}
        
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps(response).encode())
    
    def log_message(self, format, *args):
        pass  # Suppress default logging


def start_log_server(port: int = 8888):
    """Start the beacon log server."""
    server = HTTPServer(('0.0.0.0', port), BeaconLogHandler)
    print(f"[SERVER] Starting beacon logger on port {port}")
    print(f"[SERVER] Logs saved to ./beacon_logs/")
    print(f"[CTRL+C] Press Ctrl+C to stop")
    
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[SERVER] Shutting down...")
        server.shutdown()


