def embed_image_steganography(image_path: str, secret_message: str, 
                              output_path: str) -> bool:
    """
    Embed a secret message into an image using LSB steganography.
    This modifies the least significant bit of pixel colors.
    """
    try:
        from PIL import Image
    except ImportError:
        print("[ERROR] Pillow library required. Run: pip install Pillow")
        return False
    
    img = Image.open(image_path)
    if img.mode != 'RGB':
        img = img.convert('RGB')
    
    pixels = list(img.getdata())
    width, height = img.size
    
    # Encode message length + message
    msg_with_len = struct.pack('>I', len(secret_message)) + secret_message.encode('utf-8')
    binary_msg = ''.join(format(byte, '08b') for byte in msg_with_len)
    
    if len(binary_msg) > len(pixels) * 3:
        print("[ERROR] Message too large for image")
        return False
    
    # Modify LSBs
    new_pixels = []
    bit_idx = 0
    for pixel in pixels:
        r, g, b = pixel
        if bit_idx < len(binary_msg):
            r &= 0xFE
            r |= int(binary_msg[bit_idx])
            bit_idx += 1
        if bit_idx < len(binary_msg):
            g &= 0xFE
            g |= int(binary_msg[bit_idx])
            bit_idx += 1
        if bit_idx < len(binary_msg):
            b &= 0xFE
            b |= int(binary_msg[bit_idx])
            bit_idx += 1
        new_pixels.append((r, g, b))
    
    new_img = Image.new('RGB', (width, height))
    new_img.putdata(new_pixels)
    new_img.save(output_path, quality=95)
    
    return True


def extract_image_steganography(image_path: str) -> Optional[str]:
    """Extract hidden message from steganographic image."""
    try:
        from PIL import Image
    except ImportError:
        print("[ERROR] Pillow library required. Run: pip install Pillow")
        return None
    
    img = Image.open(image_path)
    if img.mode != 'RGB':
        img = img.convert('RGB')
    
    pixels = list(img.getdata())
    bits = []
    
    for pixel in pixels:
        r, g, b = pixel
        bits.append(str(r & 1))
        bits.append(str(g & 1))
        bits.append(str(b & 1))
    
    # Read message length first
    length_bits = ''.join(bits[:32])
    msg_len = int(length_bits, 2)
    
    if msg_len > 10000:  # Sanity check
        return None
    
    # Extract message
    msg_bits = bits[32:32 + msg_len * 8]
    msg_bytes = []
    for i in range(0, len(msg_bits), 8):
        byte_val = int(''.join(msg_bits[i:i+8]), 2)
        msg_bytes.append(byte_val)
    
    return bytes(msg_bytes).decode('utf-8', errors='ignore')


