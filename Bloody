    return results


def compare_dom_similarity(url1: str, url2: str) -> float:
    """
    Compare two URLs by fetching and comparing their DOM structure.
    Returns similarity score 0.0 - 1.0.
    """
    # Fetch both pages (requires requests library or similar)
    # Simplified: compare visible text similarity
    try:
        resp1 = urlopen(url1, timeout=10)
        resp2 = urlopen(url2, timeout=10)
        
        html1 = resp1.read().decode(errors='ignore')
        html2 = resp2.read().decode(errors='ignore')
        
        # Very basic similarity: Jaccard index on words
        words1 = set(html1.lower().split())
        words2 = set(html2.lower().split())
        
        intersection = len(words1 & words2)
        union = len(words1 | words2)
        
        return intersection / union if union > 0 else 0.0
        
    except Exception as e:
        print(f"[ERROR] Comparison failed: {e}")
        return 0.0


